# ==============================================================================
# MediSphere — Root .gitignore
# ==============================================================================

# Operating System
.DS_Store
Thumbs.db
*.swp
*~

# IDEs and Editors
.idea/
*.iml
.vscode/
*.sublime-project
*.sublime-workspace
.classpath
.project
.settings/

# Node / Frontend (React + Vite)
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Java / Maven Backend
backend/target/
target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Python / ML Microservice
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Temporary and Scratch Directories
scratch/
temp/
tmp/
*.log

# Presentations and documents
*.pptx
*.ppt

